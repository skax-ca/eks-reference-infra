{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "opentofu": {
      "type": "local",
      "command": ["npx", "-y", "@opentofu/opentofu-mcp-server"],
      "enabled": true
    },
    "aws-docs": {
      "type": "local",
      "command": ["uvx", "awslabs.aws-documentation-mcp-server@latest"],
      "environment": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AWS_DOCUMENTATION_PARTITION": "aws",
        "SSL_CERT_FILE": "{env:HOME}/.claude/certs/ca-bundle.pem",
        "REQUESTS_CA_BUNDLE": "{env:HOME}/.claude/certs/ca-bundle.pem",
        "AWS_CA_BUNDLE": "{env:HOME}/.claude/certs/ca-bundle.pem"
      },
      "enabled": true
    },
    "aws-mcp": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-proxy-for-aws@1.6.4",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata", "AWS_REGION=ap-northeast-2",
        "--profile", "team",
        "--read-only"
      ],
      "enabled": true
    },
    "aws-well-architected": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "awslabs.well-architected-security-mcp-server",
        "awslabs.well-architected-security-mcp-server"
      ],
      "environment": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "enabled": true
    }
  }
}
