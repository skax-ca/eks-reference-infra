{
  "mcpServers": {
    "opentofu": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@opentofu/opentofu-mcp-server"
      ],
      "env": {}
    },
    "aws-docs": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "awslabs.aws-documentation-mcp-server@latest"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AWS_DOCUMENTATION_PARTITION": "aws",
        "SSL_CERT_FILE": "${HOME}/.claude/certs/ca-bundle.pem",
        "REQUESTS_CA_BUNDLE": "${HOME}/.claude/certs/ca-bundle.pem",
        "AWS_CA_BUNDLE": "${HOME}/.claude/certs/ca-bundle.pem"
      }
    },
    "aws-api": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "awslabs.aws-api-mcp-server@latest"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AWS_REGION": "ap-northeast-2",
        "AWS_API_MCP_PROFILE_NAME": "team",
        "READ_OPERATIONS_ONLY": "true"
      }
    },
    "notepad-local": {
      "type": "stdio",
      "command": "bun",
      "args": [
        "run",
        "${CLAUDE_PROJECT_DIR:-.}/.mcp/notepad-server.ts"
      ],
      "env": {}
    }
  }
}
